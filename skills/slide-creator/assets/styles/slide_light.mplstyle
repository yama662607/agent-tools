# slide-creator Light Theme for Matplotlib
figure.dpi: 300
savefig.dpi: 300
savefig.transparent: True
savefig.bbox: tight
savefig.pad_inches: 0.05

font.family: sans-serif
font.sans-serif: Hiragino Kaku Gothic ProN, Meiryo, Noto Sans CJK JP, Arial, DejaVu Sans
font.size: 14.0
axes.titlesize: 16.0
axes.titleweight: bold
axes.labelsize: 14.0
axes.labelweight: bold
xtick.labelsize: 12.0
ytick.labelsize: 12.0

lines.linewidth: 2.5
axes.linewidth: 1.5
axes.edgecolor: "#334155"
axes.spines.top: False
axes.spines.right: False
xtick.major.width: 1.5
ytick.major.width: 1.5

axes.prop_cycle: cycler('color', ['#1E3A8A', '#0284C7', '#0D9488', '#E11D48', '#D97706'])
